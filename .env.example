# ==============================================================================
# DARB | دَرْب — Environment Configuration Template
# ==============================================================================
# When running locally in DEMO MODE, no environment variables are required!
# The website automatically activates DEMO MODE if Supabase variables are left empty.
#
# When connecting to your real Supabase instance, copy this file to .env.local
# and provide your real project credentials from your Supabase Dashboard:
# Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Supabase service role key (NEVER expose to browser client code)
# SUPABASE_SERVICE_ROLE_KEY=
